# Django Configuration
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True

# Database Configuration (Choose one)
# For Neon PostgreSQL (Production - shared database)
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# For Local PostgreSQL (Development)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/procure_to_pay_db
# DB_NAME=procure_to_pay
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# OpenAI API Key (Required for AI features)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# CORS and Security
ALLOWED_HOSTS=localhost,127.0.0.1,procure-to-pay-backend.fly.dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://procure-to-pay-system.vercel.app