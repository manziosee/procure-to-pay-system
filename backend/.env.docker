# Docker Environment Configuration
# Copy this file to .env and update with your actual values

# Security
SECRET_KEY=<generate-secure-secret-key>
DEBUG=False

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# API Keys
OPENAI_API_KEY=<your-openai-api-key>

# CORS & Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,backend,procure-to-pay-backend.fly.dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://procure-to-pay-system.vercel.app

# File Upload Limits
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760